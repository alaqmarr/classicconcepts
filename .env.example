# Database & Auth
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Dual-Agent Anthropic Configuration (Strictly claude-haiku-5-5 Only)
# Can be configured here OR directly inside Admin -> Site Settings -> AI Settings
ANTHROPIC_CLIENT_API_KEY=""
ANTHROPIC_ADMIN_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# 100MB Pure In-Memory Redis Cache (auto-configured on Linux server via scripts/setup-redis-100mb.sh;
# automatically falls back to a 100MB byte-metered in-memory LRU engine in local dev when Redis is offline)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_MAXMEMORY_BYTES="104857600"
